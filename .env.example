# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
# Only variables prefixed with VITE_ are bundled into the browser build, so they MUST be
# safe to make public. Everything else is server-only (Vercel Functions / local scripts)
# and must never get a VITE_ prefix.
#
# This file lists names only. Keep every value empty here.

# --- Supabase (server only; the service role key bypasses RLS) ---
# Supabase project URL
SUPABASE_URL=
# Service role key: full database access, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser; public by design, protected by Row Level Security) ---
# Same project URL as above, for the admin login page
VITE_SUPABASE_URL=
# Anon (public) key for the admin login page
VITE_SUPABASE_ANON_KEY=

# --- AI providers (server only) ---
# Google AI Studio key (embeddings + fallback LLM)
GEMINI_API_KEY=
# Groq key (primary LLM + Whisper speech-to-text)
GROQ_API_KEY=

# --- Model settings (server only; verify current model IDs when building) ---
# Primary chat model ID
LLM_MODEL=
# Fallback chat model ID
LLM_FALLBACK_MODEL=
# Second Groq chat model, tried if both of the above fail (P5)
LLM_SECONDARY_MODEL=
# Embedding model ID
EMBED_MODEL=
# Embedding dimensions (the plan uses 768)
EMBED_DIM=
# Speech-to-text model ID
STT_MODEL=

# --- Chat tuning (server only) ---
# Minimum retrieval similarity before the LLM is called
RAG_MIN_SIMILARITY=
# Global daily cap on chat requests
CHAT_DAILY_CAP=

# --- Contact form email via Gmail SMTP (server only) ---
# Gmail address used to send
SMTP_USER=
# Gmail App Password #1 (not your normal password)
SMTP_APP_PASSWORD=
# Address that receives contact messages
CONTACT_TO=

# --- Cloudflare Turnstile ---
# Turnstile secret key (server only)
TURNSTILE_SECRET_KEY=
# Turnstile site key (browser; public by design)
VITE_TURNSTILE_SITE_KEY=

# --- Misc secrets (server only) ---
# Random salt used to hash visitor IPs before storing them
IP_HASH_SALT=
# Shared secret that protects the Vercel Cron keep-alive endpoint
CRON_SECRET=
