# Supply-chain hardening (see docs/security.md, control C3).
# New dependencies are saved with exact versions (no ^ or ~).
save-exact=true
# Any dependency with install scripts that is not listed in package.json "allowScripts"
# fails the install instead of silently running code on this machine.
strict-allow-scripts=true
# P11: never run a dependency's lifecycle scripts on install (only fsevents, an optional macOS file watcher,
# has one and it is denied in package.json "allowScripts"). `npm run <script>` still works.
ignore-scripts=true
