# Store LF in the repository (Vercel builds on Linux); avoids CRLF warnings on Windows.
* text=auto eol=lf

# Binary files: never convert line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.glb binary
*.gltf-binary binary
*.bin binary
*.blend binary
*.aep binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
